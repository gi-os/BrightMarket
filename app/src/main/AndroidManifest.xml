<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this the PackageInstaller session can't even reach the system's
         own confirmation dialog. It is not a silent-install permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        Required to launch the system uninstaller at all. Without it ACTION_DELETE
        is refused before any UI appears, which is why the uninstall action did
        nothing no matter how large the tap target was made. It grants no power
        to remove anything: the system still shows its own confirmation and the
        user still has to agree. This only buys the right to ask.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Scanning a QR from the desktop catalog, or a GitHub repo URL. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Package visibility. Since API 30 an app cannot see other installed
      packages at all: getPackageInfo throws NameNotFoundException for anything
      not declared here, whether or not the app is actually installed.

      That silently broke the entire installed/updates model. Every lookup threw,
      every result was null, so nothing was ever "installed": apps that were
      plainly on the phone sat under "not installed", and no update was ever
      offered for anything.

      QUERY_ALL_PACKAGES rather than a queries element because the list isn't
      knowable at build time: it is whatever the index carries plus whatever
      repos the user has tracked. Checking what is installed in order to update
      it is the sanctioned use of this permission for an installer.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Market"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrightMarket">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="Market"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BrightMarket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- QR codes from the desktop catalog carry brightmarket:// links.
                 BrightMarket never opens the camera itself: the phone already
                 has a QR scanner (Roll), so scanning there fires this intent.
                 That avoids bundling CameraX and a decoder, and avoids holding
                 a camera permission this app has no other reason to want. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brightmarket" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gios.brightmarket.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
