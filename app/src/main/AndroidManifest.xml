<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without this the PackageInstaller session can't even reach the system's
         own confirmation dialog. It is not a silent-install permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Market"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrightMarket">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Market"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BrightMarket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gios.brightmarket.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
